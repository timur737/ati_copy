# ─── Postgres ───────────────────────────────────────
POSTGRES_USER=ati_user
POSTGRES_PASSWORD=ati_password
POSTGRES_DB=ati_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full async URL used by SQLAlchemy
DATABASE_URL=postgresql+asyncpg://ati_user:ati_password@postgres:5432/ati_db

# ─── Redis ──────────────────────────────────────────
REDIS_PASSWORD=redis_password
REDIS_URL=redis://:redis_password@redis:6379/0

# ─── JWT ────────────────────────────────────────────
SECRET_KEY=change-me-to-a-very-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── App ────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
CORS_ORIGINS=["http://localhost:3000", "http://147.45.107.202:3000", "http://147.45.107.202"]

# ─── Frontend ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://147.45.107.202:8000
